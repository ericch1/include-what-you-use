// Uses IndirectClass without #including indirect.h.  The #include of
// implementation_file.h is redundant, since that file #includes this one:
// it is kept, but not required.

#include "implementation_file.h"

inline void ImplFileClass::InlineMethod() {
  IndirectClass local;
  local.Method();
}

// A forward-declare use of ImplFileClass, satisfied by the header.
inline bool ImplFileClass::Equals(const ImplFileClass& other) const {
  return this == &other;
}

template <typename T>
void ImplFileClass::TemplateMethod(T t) {
  IndirectClass local;
  local.a = t;
}

inline int ImplFileFunction(int i) {
  IndirectClass local;
  return local.a + IMPL_FILE_TWICE(i);
}

template <typename T>
T ImplFileTemplate(T t) {
  IndirectClass local;
  return local.a + t;
}

#include "tests/cxx/implementation_file-detail.icc"

